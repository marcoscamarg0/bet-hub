# Conexão com MongoDB Atlas
# Exemplo: mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/bethub?retryWrites=true&w=majority
MONGO_URI=

# Segredo para assinar tokens JWT (troque por uma string aleatória longa)
JWT_SECRET=troque-este-segredo-por-algo-bem-grande-e-aleatorio

# Porta do servidor
PORT=4000

# Origem permitida para CORS (URL do seu frontend)
CORS_ORIGIN=http://localhost:5173

# Dados do admin inicial (usados pelo script seed:admin)
ADMIN_EMAIL=admin@bethub.com
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Admin
